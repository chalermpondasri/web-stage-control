{
    "name": "billboard",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "test": "jest",
        "build": "npm run build:auth && npm run build:migration && npm run build:search && npm run build:media",
        "build:auth": "nest build auth",
        "build:migration": "nest build migration",
        "build:search": "nest build search",
        "build:media": "nest build media",
        "start": "npm run start:prod",
        "dev": "nest start auth --tsc --watch",
        "dev:migration": "nest start migration --tsc --watch",
        "dev:media": "nest start media --tsc --watch",
        "debug": "nest start auth --debug --tsc --watch",
        "debug:migration": "nest start migration --debug --tsc --watch",
        "debug:media": "nest start media --debug --tsc --watch",
        "start:prod": "node dist/apps/auth",
        "start:migration": "node dist/migration",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prettier:fix": "prettier . --write",
        "env": "dotenv-vault",
        "prepare": "husky install",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:migrate-run": "npm run typeorm migration:run --  --dataSource ./libs/config/typeormConfig",
        "typeorm:migrate-revert": "npm run typeorm migration:revert --  --dataSource ./libs/config/typeormConfig"
    },
    "dependencies": {
        "@elastic/elasticsearch": "^8.15.0",
        "@golevelup/nestjs-rabbitmq": "^5.5.0",
        "@nestjs/common": "^10.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^10.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/schedule": "^4.0.2",
        "@nestjs/swagger": "^7.4.2",
        "@types/amqplib": "^0.10.5",
        "accept-language-parser": "^1.5.0",
        "amqplib": "^0.10.4",
        "axios": "^1.7.7",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dayjs": "^1.11.8",
        "decimal.js": "^10.4.3",
        "dotenv": "^16.4.5",
        "elastic-apm-node": "^4.8.0",
        "husky": "^8.0.3",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.13.0",
        "qs": "^6.13.0",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.20",
        "ua-parser-js": "^1.0.39",
        "uuid": "^10.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/accept-language-parser": "^1.5.6",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.13",
        "@types/jest": "^29.5.1",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/node": "^20.16.11",
        "@types/supertest": "^2.0.11",
        "@types/ua-parser-js": "^0.7.39",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "cypress": "^13.15.1",
        "eslint": "^8.0.1",
        "eslint-config-prettier": "^9.0.0",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.10",
        "prettier": "3.0.3",
        "prettier-plugin-multiline-arrays": "^3.0.6",
        "prettier-plugin-organize-imports": "^3.2.3",
        "source-map-support": "^0.5.20",
        "ts-jest": "^29.1.2",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.0.0",
        "webpack": "latest"
    },
    "lint-staged": {
        "*.{js,ts}": "eslint --cache --fix",
        "*.{js,ts,css,md}": "prettier --write"
    },
    "engines": {
        "node": "20"
    }
}
