{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "webpack": true,
        "tsConfigPath": "tsconfig.json"
    },
    "monorepo": true,
    "projects": {
        "auth": {
            "type": "application",
            "root": "apps/auth",
            "entryFile": "index",
            "sourceRoot": "apps/auth/src",
            "compilerOptions": {
                "tsConfigPath": "apps/auth/tsconfig.app.json"
            }
        },
        "migration": {
            "type": "application",
            "root": "apps/migration",
            "entryFile": "index",
            "sourceRoot": "apps/migration/src",
            "compilerOptions": {
                "tsConfigPath": "apps/migration/tsconfig.app.json"
            }
        },
        "mq-consumer": {
            "type": "application",
            "root": "apps/mq-consumer",
            "entryFile": "index",
            "sourceRoot": "apps/mq-consumer/src",
            "compilerOptions": {
                "tsConfigPath": "apps/mq-consumer/tsconfig.app.json"
            }
        },
        "search": {
            "type": "application",
            "root": "apps/search",
            "entryFile": "index",
            "sourceRoot": "apps/search/src",
            "compilerOptions": {
                "tsConfigPath": "apps/search/tsconfig.app.json"
            }
        },
        "media": {
            "type": "application",
            "root": "apps/media",
            "entryFile": "index",
            "sourceRoot": "apps/media/src",
            "compilerOptions": {
                "tsConfigPath": "apps/media/tsconfig.app.json"
            }
        }
    }
}