{
    "name": "bun-boilerplate",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "MIT",
    "scripts": {
        "test": "jest",
        "build": "nest build main",
        "build:main": "nest build main",
        "build:migration": "nest build migration",
        "start": "npm run start:prod",
        "dev": "nest start main --tsc --watch",
        "dev:migration": "nest start migration --tsc --watch",
        "debug": "nest start main --debug --tsc --watch",
        "debug:migration": "nest start migration --debug --tsc --watch",
        "start:prod": "node dist/apps/main",
        "start:migration": "node dist/migration",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prettier:fix": "prettier . --write",
        "env": "dotenv-vault",
        "prepare": "husky install",
        "typeorm": "ts-node ./node_modules/typeorm/cli",
        "typeorm:migrate-run": "npm run typeorm migration:run --  --dataSource ./libs/config/typeormConfig",
        "typeorm:migrate-revert": "npm run typeorm migration:revert --  --dataSource ./libs/config/typeormConfig"
    },
    "dependencies": {
        "@nestjs/common": "^9.0.0",
        "@nestjs/config": "^3.1.1",
        "@nestjs/core": "^9.0.0",
        "@nestjs/passport": "^10.0.0",
        "@nestjs/platform-express": "^9.0.0",
        "@nestjs/schedule": "^4.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dayjs": "^1.11.8",
        "decimal.js": "^10.4.3",
        "husky": "^8.0.3",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.2.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^9.0.0",
        "@nestjs/schematics": "^9.0.0",
        "@nestjs/testing": "^9.0.0",
        "@types/express": "^4.17.13",
        "@types/jest": "^29.5.1",
        "@types/node": "^18.16.12",
        "@types/supertest": "^2.0.11",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^8.0.1",
        "eslint-config-prettier": "^9.0.0",
        "jest": "^29.7.0",
        "lint-staged": "^14.0.1",
        "prettier": "3.0.3",
        "prettier-plugin-organize-imports": "^3.2.3",
        "source-map-support": "^0.5.20",
        "ts-jest": "^29.1.2",
        "ts-loader": "^9.2.3",
        "ts-node": "^10.0.0",
        "tsconfig-paths": "4.2.0",
        "typescript": "^5.0.0",
        "webpack": "latest"
    },
    "lint-staged": {
        "*.{js,ts}": "eslint --cache --fix",
        "*.{js,ts,css,md}": "prettier --write"
    }
}
