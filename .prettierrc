{
  "plugins": [
    "prettier-plugin-organize-imports",
    "prettier-plugin-multiline-arrays"
  ],
  "singleQuote": true,
  "useTabs": false,
  "tabWidth": 4,
  "semi": false,
  "quoteProps": "consistent",
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "printWidth": 120,
  "proseWrap": "preserve",
  "multilineArraysWrapThreshold": 0
}