{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": true,
        "webpack": true,
        "tsConfigPath": "tsconfig.json"
    },
    "monorepo": true,
    "projects": {
        "main": {
            "type": "application",
            "root": "apps/main",
            "entryFile": "index",
            "sourceRoot": "apps/main/src",
            "compilerOptions": {
                "tsConfigPath": "apps/main/tsconfig.app.json"
            }
        }
    }
}
